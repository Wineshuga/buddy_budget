<!DOCTYPE html>
<html>
  <head>
    <title>BuddyBudget - Personal Finance & Budget Tracker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="mobile-device-wrapper">
      <div class="mobile-screen">
        <% if notice.present? %>
          <div class="flash-toast fade-out notice-wrapper">
            <p class="notice"><%= notice %></p>
          </div>
        <% else %>
          <p class="notice" style="display:none;"></p>
        <% end %>

        <% if alert.present? %>
          <div class="flash-toast fade-outalert-wrapper">
            <p class="alert"><%= alert %></p>
          </div>
        <% else %>
          <p class="alert" style="display:none;"></p>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>

