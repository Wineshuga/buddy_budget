<nav>
  <div>
    <%= link_to '‹', categories_path %>
  </div>
  <div>
    <h2>Transactions</h2>
  </div>
  <%= button_to 'Sign Out', destroy_user_session_path, method: :delete %>
</nav>

<div class="category-hero-container">
  <section class="main-category">
    <div class="category-box">
      <div class="category-hero-img-box">
        <% if @category.image.attached? %>
          <img src="<%= @category.image.url %>" alt="<%= @category.name %>">
        <% elsif @category.icon.present? %>
          <img src="<%= @category.icon %>" alt="<%= @category.name %>">
        <% else %>
          <span class="category-hero-fallback">🏷️</span>
        <% end %>
      </div>
      <div class="category-hero-text">
        <span class="category-hero-label">Category</span>
        <h3><%= @category.name %></h3>
      </div>
    </div>
    <% procurement_sum = @procurements.sum(&:amount) %>
    <div class="category-total-badge">
      <span class="total-label">Total Spent</span>
      <p class="total-amount">NGN <%= procurement_sum %></p>
    </div>
  </section>
</div>

<section class="main">
  <% if @procurements.empty? %>
    <div class="empty-state">
      <div class="empty-icon">💸</div>
      <h3>No Transactions Found</h3>
      <p>No transactions added for <%= @category.name %> yet.</p>
    </div>
  <% else %>
    <div class="procurements-list">
      <% @procurements.each do |procurement| %>
        <section class="procurement">
          <div class="procurement-info">
            <div class="procurement-icon">🧾</div>
            <div>
              <p class="procurement-title"><%= procurement.name %></p>
              <p class="procurement-date"><%= procurement.updated_at.strftime("%d %b %Y, %I:%M %p") %></p>
            </div>
          </div>
          <div class="procurement-amount-tag">
            <p>NGN <%= procurement.amount %></p>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</section>

<div class="add-btn btn">
  <div class="inner-btn">
    <%= link_to 'Add a New Transaction', new_category_procurements_path %>
  </div>
</div>

