<nav>
  <div>
    <%= link_to '<', root_path %>
  </div>
  <div>
    <h2>Log in</h2>
  </div>
</nav>
<section class="login-page">
  <div class="auth-card">
    <div class="auth-header">
      <h3>Welcome Back!</h3>
      <p>Log in to access your budget overview.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "e.g. alex@example.com" %>
      </div>

      <div class="field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field remember-field">
          <label class="remember-label">
            <%= f.check_box :remember_me %>
            <span>Remember me</span>
          </label>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in" %>
      </div>
    <% end %>

    <div class="devise-links-container">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>

