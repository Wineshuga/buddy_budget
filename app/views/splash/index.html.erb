<section class="splash">
  <div class="splash-main">
    <div class="splash-icon-wrapper">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 7V17C21 18.6569 19.6569 20 18 20H6C4.34315 20 3 18.6569 3 17V7C3 5.34315 4.34315 4 6 4H18C19.6569 4 21 5.34315 21 7Z" stroke="currentColor" stroke-width="2"/>
        <path d="M16 12C16 12.5523 16.4477 13 17 13C17.5523 13 18 12.5523 18 12C18 11.4477 17.5523 11 17 11C16.4477 11 16 11.4477 16 12Z" fill="currentColor"/>
        <path d="M3 9H21" stroke="currentColor" stroke-width="2"/>
      </svg>
    </div>
    <h1 id="logo">BuddyBudget</h1>
    <p class="splash-tagline">Smart & simple expense tracking for your everyday budget.</p>
  </div>
  <div class="splash-link">
    <%= link_to 'Sign In', new_user_session_path, class: "splash-linkOne btn" %>
    <%= link_to 'Sign Up', new_user_registration_path, class: "splash-linkTwo btn" %>
  </div>
</section>

